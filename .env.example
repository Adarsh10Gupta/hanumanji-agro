# Copy to .env.local and replace every placeholder with a value from your own services.
# Use a dedicated Hanumanji Agro Atlas database user. Percent-encode reserved URI characters.
MONGODB_URI=mongodb+srv://<username>:<percent-encoded-password>@<cluster-host>/hanumanji_agro?retryWrites=true&w=majority
SESSION_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
ADMIN_BOOTSTRAP_EMAIL=<owner-email>
ADMIN_BOOTSTRAP_PASSWORD=<unique-password-at-least-16-characters>
RESEND_API_KEY=<resend-api-key>
# For development, use onboarding@resend.dev. Production requires your verified sender domain.
EMAIL_FROM=<sender-name> <sender-email>
OWNER_NOTIFICATION_EMAIL=<owner-notification-email>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional WhatsApp Cloud API approved-template sender.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v22.0
NEXT_PUBLIC_SITE_URL=https://hanumanjiagro.com
